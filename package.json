{
  "name": "frida-region-launcher",
  "version": "0.2.0-beta.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "description": "Windows per-process region simulation launcher",
  "author": "Frida Region Launcher contributors",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "test": "vitest run",
    "test:backend": "node scripts/run-python.mjs -m unittest discover -s tests/backend -v",
    "package": "tsc --noEmit && vite build && node scripts/build-electron.mjs && electron-builder --win portable --x64",
    "test:integration": "node scripts/run-python.mjs tests/windows-integration/run.py",
    "test:ui": "node scripts/smoke-electron.mjs",
    "build:backend": "node scripts/run-python.mjs scripts/build-backend.py"
  },
  "dependencies": {
    "@radix-ui/react-switch": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
